   "metadata": {},
   "source": [
    "## Genre Relation ship matrix is A"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b4183221",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.array([\n",
    "    [4,2,1],\n",
    "    [2,3,1],\n",
    "    [1,1,2]\n",
    "])\n",
    "\n",
    "# Eigenvalues and Eigenvectors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "7a8374cd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[6.04891734 1.64310413 1.30797853]\n",
      "[[ 0.73697623  0.59100905  0.32798528]\n",
      " [ 0.59100905 -0.32798528 -0.73697623]\n",
      " [ 0.32798528 -0.73697623  0.59100905]]\n"
     ]
    }
   ],
   "source": [
    "eigVals, eigVec = np.linalg.eig(A)\n",
    "print(eigVals)\n",
    "print(eigVec)"
   ]
  }
